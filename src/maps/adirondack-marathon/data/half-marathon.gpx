<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="False Summit Studio — build_adk_gpx_overpass.py">
  <metadata>
    <name>Adirondack Half Marathon course</name>
    <desc>Second half of the full-marathon course, Hamlet of Adirondack -&gt; Schroon Public Beach (13.87 mi OSRM road distance; USATF-certified 13.1, NY21013JG). Sliced from the marathon route so both overlap exactly.</desc>
  </metadata>
  <wpt lat="43.764524" lon="-73.755940">
    <name>Start: Hamlet of Adirondack (half-marathon start, marathon mile 13.1)</name>
  </wpt>
  <wpt lat="43.733120" lon="-73.817600">
    <name>US-9 at Pottersville (relay exchange)</name>
  </wpt>
  <wpt lat="43.835947" lon="-73.757290">
    <name>Finish: Schroon Public Beach (Leland Ave)</name>
  </wpt>
