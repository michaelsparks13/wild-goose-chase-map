<?xml version='1.0' encoding='utf-8'?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="False Summit Studio — build_adk_gpx_overpass.py">
  <metadata>
    <name>Adirondack Marathon course</name>
    <desc>Clockwise loop around Schroon Lake, NY (26.36 mi OSRM road distance; USATF-certified 26.2, NY21011JG). OSM-derived waypoints routed via OSRM. Water/sports drink at ~15 stations: roughly every 2 mi to mile 20, then every mile from 20-25. Relay exchanges at miles 4.4, 13.1, 18.2.</desc>
  </metadata>
  <wpt lat="43.835120" lon="-73.762160">
    <name>Start: Main St (US-9), Village of Schroon Lake</name>
  </wpt>
  <wpt lat="43.857510" lon="-73.716460">
    <name>Mile 4.4: Crane Pond Rd / top of Adirondack Rd</name>
  </wpt>
  <wpt lat="43.764520" lon="-73.755940">
    <name>Mile 13.1: Hamlet of Adirondack (East Shore Dr)</name>
  </wpt>
  <wpt lat="43.733120" lon="-73.817600">
    <name>Mile 18.2: US-9 at Pottersville</name>
  </wpt>
  <wpt lat="43.835950" lon="-73.757290">
    <name>Finish: Schroon Public Beach (Leland Ave)</name>
  </wpt>
